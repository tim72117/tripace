# Backend the partner SPA talks to (see src/api.ts). Copy this file to
# .env.local and adjust for your environment; .env.local is gitignored.
# In production this SPA is served same-origin from /partner, so this is
# only needed for local dev against a separately-running backend.
VITE_PARTNER_API_URL=http://localhost:8082

# Where POST /v1/auth/login lives — ONLY cmd/server (the main backend,
# :8080) exposes this, not cmd/partnerserver. In production both sit
# behind the same origin so this isn't needed (falls back to
# VITE_PARTNER_API_URL above); locally they're two different ports, so
# this must point at cmd/server specifically or login will 404 against
# partnerserver.
VITE_MAIN_API_URL=http://localhost:8080
