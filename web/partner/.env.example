# Backend the partner SPA talks to (see src/api.ts). Copy this file to
# .env.local and adjust for your environment; .env.local is gitignored.
# In production this SPA is served same-origin from /partner, so this is
# only needed for local dev against a separately-running backend.
VITE_PARTNER_API_URL=http://localhost:8080

# Where POST /v1/auth/login lives. The partner API is now part of the main
# server (cmd/server, :8080), so this is normally the same as
# VITE_PARTNER_API_URL and can be left out (it falls back to it).
VITE_MAIN_API_URL=http://localhost:8080
