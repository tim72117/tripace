# 前端環境變數範本——複製這個檔案為 .env.development.local（本機開發）
# 或 .env.production.local（本機模擬正式環境時使用），依需要填值。
# 兩者皆已被 web/.gitignore 的 *.local 規則排除，不會進版控。
#
# 不含機密、可直接進版控的變數（如 VITE_PACE_PUBLIC_LINK_TOKEN）已經
# 寫在 .env.development / .env.production，不重複列在這裡。

# --- onagent 平台 ---------------------------------------------------------

# onagent 平台的 tripace app apiKey——只顯示一次，重發會讓舊 key 立刻
# 失效，見 .claude/skills/onagent-cli-setup 的說明。
VITE_ONAGENT_APP_KEY=

# onagent 平台位址：本機開發通常是 http://localhost:8000，正式環境是
# https://onagent.shuttle.tools。
VITE_ONAGENT_URL=

# --- Google Maps ------------------------------------------------------------

# Maps JavaScript API 用的金鑰，目前沒有 HTTP referrer 限制，不能提交
# 進版控。
VITE_GOOGLE_MAPS_API_KEY=

# AdvancedMarkerElement（景點/飯店/推薦地點/行程 entry/搜尋候選皆用此
# marker 類型）強制要求要有 Map ID 才能顯示——只設 API key、忘了設這個
# 值，marker 會全部不顯示（見 CHANGELOG v0.4.4）。
VITE_GOOGLE_MAPS_MAP_ID=

# --- Google 帳號登入（GSI 模式）---------------------------------------------

# 見 web/src/hooks/useGoogleSignIn.ts、web/src/home/LoginForm.tsx。
# 這個 Client ID 本身不是機密（本來就會出現在前端 bundle 裡，真正的信任
# 邊界在後端對 ID Token 的簽章/audience 驗證，見
# server/internal/auth/google.go），但每個開發者/環境通常會各自在
# Google Cloud Console 建立自己的 OAuth Client（應用程式類型必須選
# 「網頁應用程式」，Desktop app 類型沒有「已授權的 JavaScript 來源」
# 欄位，無法用於網站登入；Authorized JavaScript origins 要對應各自的
# 本機/部署網域），不適合寫死共用一份值進版控。
# 未設定時 LoginForm 不會顯示 Google 登入按鈕（優雅降級，不報錯也不
# 顯示壞掉的按鈕），其餘登入方式不受影響。
VITE_GOOGLE_OAUTH_CLIENT_ID=

# --- 開發用 feature flag（僅本機開發環境需要，正式部署預設全部關閉）------

# 見 DesktopShared.tsx 的 TIMELINE_ENABLED/PACE_ENABLED/
# DEMO_ONAGENT_ENABLED/DEBUG_PANEL_ENABLED/DEMO_ROUTE_EDITOR_ENABLED
# 說明。未設定時視為 false。
VITE_FEATURE_TIMELINE=
VITE_FEATURE_PACE=
VITE_FEATURE_DEMO_ONAGENT=
VITE_FEATURE_DEBUG_PANEL=
VITE_FEATURE_DEMO_ROUTE_EDITOR=
