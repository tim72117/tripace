dist
# vite-plugin-pwa 的 devOptions.enabled: true(本機開發模式下也啟用 PWA,
# 見 vite.config.ts)會在這裡寫出開發用的 service worker 產物,跟 dist 一樣
# 是每次啟動都重新產生的建置產物,不應提交進版控。
dev-dist
*.local
.vite

# TypeScript 增量編譯快取:每次 tsc 執行都會重新產生,內容跟本機環境/
# 磁碟版本綁定,不應提交進版控。
tsconfig.tsbuildinfo

# Playwright(tests/e2e-mock-llm.spec.ts)執行後產生的暫存輸出:失敗截圖、
# trace.zip、HTML 報表。每次執行都會重新產生,不應提交進版控。
test-results
playwright-report
