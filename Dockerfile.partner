# partnerserver 容器映像(廣告業主/聯盟行銷夥伴控制台,獨立於主服務
# tripace-server 與 tripace-adminserver)。
# build context 為「專案根目錄」,COPY 路徑相對根目錄寫(server/...),
# 與主服務、adminserver 共用同一份 server/ 原始碼與 go.mod,只是編譯
# 目標換成 ./cmd/partnerserver。完全比照 Dockerfile.admin 的既有結構
# (見該檔案開頭註解),只是前端來源換成 web/partner、embed 目標換成
# cmd/partnerserver。
#
# 建置(從專案根目錄):
#   docker build -f Dockerfile.partner -t tripace-partnerserver .
# 本機跑:
#   docker run --rm -p 8082:8082 --env-file server/.env tripace-partnerserver

# ---- 階段 1:build 前端(partner SPA) ----
FROM node:22-alpine AS web-build
WORKDIR /web
COPY web/partner/package.json web/partner/package-lock.json ./
RUN npm ci
COPY web/partner/ ./
RUN npm run build

# ---- 階段 2:編譯 Go ----
FROM golang:1.26 AS build

COPY server/go.mod server/go.sum /src/server/
RUN cd /src/server && go mod download

COPY server/ /src/server/

# 把 partner SPA 的 build 產物放到 partnerserver embed 路徑,覆蓋掉本機
# 開發用的佔位 index.html(見 server/cmd/partnerserver/web/dist/index.html
# 的完整說明)。
COPY --from=web-build /web/dist /src/server/cmd/partnerserver/web/dist

RUN cd /src/server && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/partnerserver ./cmd/partnerserver

# ---- 階段 3:執行 ----
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/partnerserver /app/partnerserver

# Cloud Run 會注入 PORT;main.go 讀 PORT 覆寫監聽位址(預設 :8082)。
EXPOSE 8082
ENTRYPOINT ["/app/partnerserver"]
