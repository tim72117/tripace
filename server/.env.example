# Tripace server 環境變數範本。
# 複製成 server/.env 後填入實際值;.env 含密碼,已被 .gitignore 排除,不進版控。
#
# 參數行都不註解(編輯器才會高亮):值留空 = 與未設定相同(程式一律以空字串視為未設),
# 有數字或 true 的是程式碼本身的預設值,照抄不會改變行為。需要開啟的功能才填值。
#
# 啟動時 cmd/server 會自動載入 server/.env(godotenv),DB 選擇由 DATABASE_URL 決定:
#   - 設了 DATABASE_URL=postgresql://… → 用 Postgres(正式環境為 Cloud SQL),啟動 log 顯示 DB=postgres
#   - 留空 / 註解掉             → 退回本機 SQLite(-db 旗標,預設 tripace.db)

# 一般 Postgres 連線字串格式(例如本機 docker-compose 起的 Postgres):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cloud SQL(Postgres,正式環境)。Cloud Run 透過 --add-cloudsql-instances
# 掛載 Unix socket 到 /cloudsql/INSTANCE_CONNECTION_NAME,不走公開 IP,
# 連線字串省略 host、改用 ?host= 指向該 socket:
# DATABASE_URL=postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
#
# 本機開發若要連同一台 Cloud SQL,改用 Cloud SQL Auth Proxy 在本機開一個 port,
# 連線字串照一般 TCP 格式打 localhost:PORT 即可,不用 ?host=/cloudsql/...。

DATABASE_URL=

# 監聽埠。平台(Cloud Run)會注入 PORT,有設時覆寫 -addr(預設 127.0.0.1:8080)。
PORT=

# JWT 簽章金鑰。不設則用開發預設值(dev-secret-change-me)——正式環境一定要
# 設成自己的隨機值。cmd/server 與 cmd/adminserver 必須用同一個值才能互相驗證 token。
# 範例:JWT_SECRET=dev-secret-change-me(留空就是這個開發預設值)
JWT_SECRET=

# 開發模式:true 時 Apple token 不驗簽章(預設 true,正式環境要設成 false)。
DEV_MODE=true

# 資料庫為空時是否寫入示範資料(Alice/Bob 等假帳號;預設 true)。
SEED=true

# 網站正式網域(不含結尾斜線),SEO meta 的 canonical/og:url 用。
# 不設則用 https://tripace.io。
# 範例:SITE_BASE_URL=https://tripace.io(留空就是這個)
SITE_BASE_URL=

# (僅測試/建置用)設成 true 時 cmd/server 的 SEO meta 測試會要求前端已建置出真的
# dist;Dockerfile 的測試階段會開。本機跑測試不需要設。
# 範例:SEO_META_TEST_REQUIRE_REAL_BUILD=true
SEO_META_TEST_REQUIRE_REAL_BUILD=

# 管理後台(/admin/api/*,獨立前端見 web/admin)。ADMIN_ENABLED 是總開關:
# 留空 / 非 truthy 值時,整個功能完全不會被建立或注冊,如同不存在。
# 範例:ADMIN_ENABLED=true
ADMIN_ENABLED=

# 管理後台的管理權限白名單:這個 email 對應的一般使用者帳號(透過一般的
# /v1/auth/* 登入流程,如 email/密碼或第三方登入),登入後可以存取管理後台
# (/admin/api/*)——管理後台不再有獨立的帳號/密碼系統,改成直接沿用一般
# 使用者的 JWT,只是多了這一層 email 比對(見 internal/adminconsole 的
# withAdmin 完整說明)。留空時沒有任何人能通過管理權限檢查。
# 範例:ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_EMAIL=

# /internal/* 端點(供 cmd/cli 用)現在跟 /v1/* 一般使用者共用同一套 JWT 驗證
# (見 internal/api/middleware.go 的 internalAuth),不再有獨立的共享密鑰環境
# 變數。cmd/cli 端先執行一次 `tripace-cli login --web` 走瀏覽器核准流程換發
# JWT、存在本機(見 cmd/cli/token.go),之後的指令會自動帶上,不需要另外設定
# 任何環境變數。

# Google Places API (New) 金鑰——地點詳情、文字搜尋、附近搜尋、geocode、照片下載
# 全部用這一把(internal/geo、internal/onagenttools、管理後台健檢)。到 Google
# Cloud Console 啟用 Places API (New) 後建立,金鑰屬於哪個專案就算誰的帳。
# 留空時這些查詢一律回 ErrNoKey,地點相關功能整體不可用。含密鑰,只放 .env。
GOOGLE_PLACES_API_KEY=

# 對 Google Places/Geocoding API 的節流設定(見 internal/apigateway 的說明,
# 整個 process 共用一份額度)。<=0 表示不限制,預設就是不限制(排隊型節流
# 會讓批次查詢逾時,已移除);總量保護改由下面的拒絕型限流負責。
GOOGLE_PLACES_MAX_CONCURRENCY=0
GOOGLE_PLACES_MIN_INTERVAL_MS=0

# 各 Google 端點的拒絕型限流初始值(視窗秒數 / 視窗內最多呼叫次數)。超過直接
# 拒絕、不打 Google。這些只是「資料庫還沒有該端點設定」時的起始值;之後以
# tripace-cli rate-limit list / set 為準(約 45 秒內生效,不需重啟),
# 見 internal/ratelimits 的登錄表。
# places.get(地點資訊):預設 60 秒 300 次
GOOGLE_PLACES_GET_RATE_LIMIT_WINDOW_SEC=60
GOOGLE_PLACES_GET_RATE_LIMIT_MAX_CALLS=300
# places.photoMedia(照片下載,依張數計費):預設 60 秒 60 次,每日 100 張(0 = 不限制)
GOOGLE_PLACES_PHOTO_MEDIA_RATE_LIMIT_WINDOW_SEC=60
GOOGLE_PLACES_PHOTO_MEDIA_RATE_LIMIT_MAX_CALLS=60
GOOGLE_PLACES_PHOTO_MEDIA_RATE_LIMIT_DAILY_MAX=100
# places.searchText(城市/文字搜尋):預設 60 秒 120 次
GOOGLE_PLACES_SEARCH_TEXT_RATE_LIMIT_WINDOW_SEC=60
GOOGLE_PLACES_SEARCH_TEXT_RATE_LIMIT_MAX_CALLS=120
# places.searchNearby(附近景點/飯店):預設 60 秒 120 次
GOOGLE_PLACES_SEARCH_NEARBY_RATE_LIMIT_WINDOW_SEC=60
GOOGLE_PLACES_SEARCH_NEARBY_RATE_LIMIT_MAX_CALLS=120
# geocode(地址轉座標):預設 60 秒 120 次
GOOGLE_PLACES_GEOCODE_RATE_LIMIT_WINDOW_SEC=60
GOOGLE_PLACES_GEOCODE_RATE_LIMIT_MAX_CALLS=120

# 訪客端點(/public/geo/plan-ai/*)的 IP 節流要信任 X-Forwarded-For 由後往前
# 數第幾筆當作來源 IP。預設 1:Cloud Run 直接面對外部流量時,最後一筆就是
# Google 代理看到的連線來源。若前面另外接了負載平衡器等代理,每多一層就加 1
# (例如 Cloud Load Balancing + Cloud Run 設 2);設太小會讓所有訪客被算成
# 同一個 IP 共用 300 次/分鐘的額度,設太大則 header 筆數不足時退回代理位址
# (一樣共用額度,但不會被偽造值繞過)。非正整數一律視為 1。
TRUSTED_PROXY_HOPS=1

# 是否向 Google Photo Media API 下載照片(依張數計費,見 geo.SetPhotosEnabled
# 的說明)。預設關閉(留空/非 truthy 值),飯店/景點/POI 查詢仍正常運作,只是
# 補不到新照片(已落地在 GCS 且未過期的照片照常顯示)。
# 範例:GOOGLE_PLACES_FETCH_PHOTOS=true(開啟後才會下載並計費)
GOOGLE_PLACES_FETCH_PHOTOS=

# Google 登入(用 Google 帳號登入,GSI/Google Identity Services 模式)的
# OAuth 2.0 Client ID——在 Google Cloud Console 建立「網頁應用程式」類型的
# OAuth Client 取得,只需要 Client ID,不需要 Client Secret(GSI 模式下
# 前端直接用官方 JS SDK 跟 Google 互動拿到 ID Token,後端只需要驗證這個
# token 的簽章與 audience,不像整頁 redirect 模式那樣需要拿 Client Secret
# 去跟 Google 換 token)。這個值本身不是機密——它會原樣出現在前端 bundle
# 裡(見 web 端的 VITE_GOOGLE_OAUTH_CLIENT_ID),Google OAuth 的安全性設計
# 本來就假設 Client ID 是公開的,真正的信任邊界是後端對 ID Token 簽章/
# audience/issuer/過期時間的驗證(見 internal/auth/google.go 的
# VerifyGoogleToken)。
#
# 留空時 POST /v1/auth/google 會一律回 401(google_verify_failed),等同
# Google 登入功能整體停用;其餘登入方式(email/password、Apple)不受影響。
# 範例:GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=

# 景點區域照片落地用的 GCS bucket 名稱(見 internal/photostorage)——
# 地點照片(漸進補圖機制下載的 Google 照片)會下載後上傳到這個 bucket,
# 留空時該功能靜默關閉。本機開發需要先 `gcloud auth
# application-default login` 取得可用的憑證;正式環境走 Cloud Run
# service account,不需要額外設定憑證,只需要對這個 bucket 有
# roles/storage.objectAdmin 權限。
#
# 本機憑證的 quota project 要是「有帳單」的專案,否則寫入會 403
# (accountDisabled):gcloud auth application-default set-quota-project <專案ID>
# (請求算在憑證的 quota project,不是 bucket 所在專案;伺服器只在啟動時讀憑證,
# 改了要重啟)。GCS 壞掉時背景補圖會被斷路器跳過(不再打 Google 計費 API),
# 狀態看 tripace-cli geo-stats show。
#
# 本機開發請用獨立的 bucket(例如 shuttle-tripace-photos-dev),不要跟
# 正式環境共用 shuttle-tripace-photos——本機手動測試補圖會寫進正式環境
# 實際會讀取的同一個物件路徑,污染正式環境的 photo_assets 對應物件。
# 範例:GCS_PHOTO_BUCKET=shuttle-tripace-photos-dev
GCS_PHOTO_BUCKET=

# 使用者上傳圖片(部落客發文配圖,見 internal/photoupload)用的 GCS
# bucket 名稱,與上面的 GCS_PHOTO_BUCKET(景點區域照片落地)分開設定——
# 兩者是不同性質的物件(使用者原創上傳 vs. 系統落地的外部照片快取),
# 混用同一個 bucket 容易在清理/權限設定上互相干擾。留空時 pre-signed
# URL 簽發功能靜默關閉(POST /v1/blog/photos/upload-url 會回錯誤)。
# 範例:BLOG_PHOTO_UPLOAD_BUCKET=shuttle-tripace-blog-uploads-dev
BLOG_PHOTO_UPLOAD_BUCKET=

# 簽發 pre-signed URL 時用來驗證簽章身份的服務帳號 email——見
# internal/photoupload 的完整說明:這裡用 GCS SDK 的 SignBytes callback
# 搭配 IAM Credentials API 的 SignBlob 間接簽章,不需要下載/保管一份
# service account JSON 私鑰檔。本機開發環境必須明確指定這個值(本機
# 偵測不到 Cloud Run/GCE 的 metadata server,查不到目前執行身份的
# email);正式環境(Cloud Run)可以留空,會自動從 metadata server 查出
# 目前執行身份的 email,不需要額外設定。本機開發者需要對這個服務帳號
# 有 roles/iam.serviceAccountTokenCreator 權限(用來呼叫 SignBlob),
# 且已執行過 `gcloud auth application-default login`。
# 範例:GCS_SERVICE_ACCOUNT_EMAIL=xxxx@your-project.iam.gserviceaccount.com
GCS_SERVICE_ACCOUNT_EMAIL=
