# migrate 容器映像(一次性資料庫/儲存維運任務,搭配 Cloud Run Jobs 使用)。
# build context 為「專案根目錄」,COPY 路徑相對根目錄寫(server/...),
# 與根目錄的 Dockerfile(主服務)、Dockerfile.admin 共用同一份 server/
# 原始碼與 go.mod,只是編譯目標換成 ./cmd/migrate-photo-assets。
#
# 2026-09:改指向 cmd/migrate-photo-assets(見該目錄 main.go 開頭註解)
# ——原本這支映像檔編譯 cmd/cli,但 cmd/cli 已經全面改走 HTTP API(不再
# 支援任何直連資料庫的操作,見 server/cmd/cli/main.go 開頭的「架構說明」
# 段落),不適合再承擔需要直連資料庫 + GCS 的批次維運操作。
# cmd/migrate-photo-assets 是目前唯一需要直連 DATABASE_URL/
# GCS_PHOTO_BUCKET 的一次性工具,故改由這支映像檔編譯它;若之後有其他
# 需要直連的一次性維運需求,應該新增對應的 cmd/migrate-* 工具,再考慮
# 是否也讓這支 Dockerfile 編譯目標參數化,而不是把不同性質的操作硬塞進
# 同一支既有工具裡。
#
# 跟 Dockerfile.admin 的差異:
#   - 不需要 web-build 階段:這支工具是純命令列工具,不 embed 任何前端。
#   - go.mod 已無私有依賴(internal/wanttools 對 github.com/tim72117/want
#     的依賴已移除,型別改為本地定義),go mod download 不再需要 GH_PAT。
#
# 用法:
#   docker build -f Dockerfile.migrate -t tripace-migrate .
#   docker run --rm \
#     -e DATABASE_URL="postgres://..." \
#     -e GCS_PHOTO_BUCKET="shuttle-tripace-photos" \
#     tripace-migrate migrate -dry-run
#   (完整子命令與旗標見 server/cmd/migrate-photo-assets/main.go 開頭說明
#   ——目前有 migrate/delete 兩個子命令,皆支援 -dry-run 與
#   -place-id 篩選範圍)
#
# 這支映像檔的 ENTRYPOINT 是執行檔本身(不含子命令),跑什麼子命令與
# 旗標由 `docker run`/Cloud Run Jobs 的 command/args 決定。

# ---- 階段 1:編譯 Go ----
FROM golang:1.26 AS build

COPY server/go.mod server/go.sum /src/server/
RUN cd /src/server && go mod download

COPY server/ /src/server/

RUN cd /src/server && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/migrate-photo-assets ./cmd/migrate-photo-assets

# ---- 階段 2:執行 ----
# distroless:只含執行檔需要的最小 runtime,無 shell、體積小、攻擊面小。
# 內含 CA 憑證,連 Cloud SQL(sslmode=require 等)與 GCS 的 TLS 才驗得過。
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/migrate-photo-assets /app/migrate-photo-assets

ENTRYPOINT ["/app/migrate-photo-assets"]
