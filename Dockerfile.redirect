# redirectserver 容器映像——把 app.shuttle.tools 的所有請求 301 導到
# https://tripace.shuttle.tools(見 server/cmd/redirectserver/main.go 的
# 完整說明)。build context 為「專案根目錄」,COPY 路徑相對根目錄寫,
# 與其餘 Dockerfile 共用同一份 server/ 原始碼與 go.mod,只是編譯目標換成
# ./cmd/redirectserver。
#
# 這支服務不依賴任何 internal 套件、不連資料庫、沒有前端——不需要
# web-build 階段,是這幾支 Dockerfile 裡最精簡的一份。go.mod 已無私有依賴
# (internal/wanttools 對 github.com/tim72117/want 的依賴已移除,型別改為
# 本地定義),go mod download 不再需要 GH_PAT。
#
# 建置(從專案根目錄):
#   docker build -f Dockerfile.redirect -t tripace-redirect .
# 本機跑:
#   docker run --rm -p 8080:8080 tripace-redirect

FROM golang:1.26 AS build

COPY server/go.mod server/go.sum /src/server/
RUN cd /src/server && go mod download

COPY server/ /src/server/

RUN cd /src/server && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/redirectserver ./cmd/redirectserver

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/redirectserver /app/redirectserver

EXPOSE 8080
ENTRYPOINT ["/app/redirectserver"]
