# ---- Go server 執行期產物(不進版控) ----
# SQLite 資料庫(server 啟動時自動建立 / seed)
server/tripace.db
server/tripace.db-shm
server/tripace.db-wal

# 環境變數(含 DB 連線字串 / 密碼,務必不進版控)
.env
server/.env

# LLM 設定(含 API key,不進版控)
server/configs/settings.json
configs/settings.json

# LLM / agent 執行日誌與工作階段
server/logs/
server/sessions/
server/entries.jsonl
server/tmp/

# 本機資料庫備份(pg_dump 等,可能含真實使用者資料,不進版控)
.backups/

# ---- 編譯產物 ----
*.exe
server/server

# tripace-cli skill 內建的本機編譯執行檔(見 .claude/skills/tripace-cli-setup
# 的說明)——16MB 二進位檔,依平台各自建置,不適合進版控。
.claude/skills/tripace-cli/bin/

# go:embed 的前端 build 產物,只在 Docker build 過程中由 COPY --from=web-build
# 產生(見 Dockerfile、Dockerfile.admin),本機驗證/除錯時手動複製進來的副本
# 不該進版控。webadmin/dist 先前漏排除,導致本機手動複製的 admin build
# 產物被 git 追蹤到,這裡一併補上(見 Dockerfile 第 74 行的 COPY --from=
# admin-build,同一套「編譯時才產生,不進版控」的既有慣例)。
server/cmd/server/web/dist/
server/cmd/server/webadmin/dist/
server/cmd/adminserver/web/dist/

# ---- 本機工作區(非主專案內容,不進版控) ----
# marketing/:行銷相關工具(如 fb-page-tools),跟 App 主體程式碼是分開維護
# 的獨立工作區。
marketing/
# tmp/:暫存檔案(如本機 docker-compose 覆寫設定),純本機用途。
tmp/

# ---- 系統 / 編輯器 ----
.DS_Store
Thumbs.db

# ---- Xcode(iOS app)----
xcuserdata/
*.xcuserstate
DerivedData/

# 注意:web/ 有自己的 .gitignore(node_modules、dist 等)
