# migrate-drop-photo-url 容器映像(一次性資料庫維運任務,搭配 Cloud Run
# Jobs 使用)。build context 為「專案根目錄」,COPY 路徑相對根目錄寫
# (server/...),與根目錄的 Dockerfile(主服務)、Dockerfile.admin、
# Dockerfile.migrate 共用同一份 server/ 原始碼與 go.mod,只是編譯目標
# 換成 ./cmd/migrate-drop-photo-url。
#
# 2026-10:新增這支獨立的 Dockerfile,而不是讓既有 Dockerfile.migrate
# 參數化改成可選編譯目標——Dockerfile.migrate 開頭註解明確寫「若之後
# 有其他需要直連的一次性維運需求,應該新增對應的 cmd/migrate-* 工具,
# 再考慮是否也讓這支 Dockerfile 編譯目標參數化,而不是把不同性質的操作
# 硬塞進同一支既有工具裡」——cmd/migrate-drop-photo-url(見該目錄
# main.go 開頭註解)是真正不可逆的 schema 變更(DROP COLUMN),跟
# cmd/migrate-photo-assets 搬移照片資料的性質不同,不應該共用同一個
# ENTRYPOINT/映像檔,避免兩支工具的部署/執行歷史混在同一個 Cloud Run
# Job 裡,也避免未來其中一支工具需要的建置步驟/base image 調整意外影響
# 到另一支。
#
# 跟 Dockerfile.migrate 的差異只有編譯目標與輸出執行檔名稱,其餘建置
# 階段(不需要 web-build、go.mod 已無私有依賴)完全相同,見該檔案的
# 完整說明。
#
# 用法:
#   docker build -f Dockerfile.migrate-drop-photo-url -t tripace-migrate-drop-photo-url .
#   docker run --rm \
#     -e DATABASE_URL="postgres://..." \
#     tripace-migrate-drop-photo-url -dry-run
#   (完整旗標說明見 server/cmd/migrate-drop-photo-url/main.go 開頭註解)
#
# 這支映像檔的 ENTRYPOINT 是執行檔本身(不含子命令——這支工具本身就
# 只有一個動作,不像 cmd/migrate-photo-assets 需要先選 migrate/delete
# 子命令),跑什麼旗標由 `docker run`/Cloud Run Jobs 的 command/args 決定。

# ---- 階段 1:編譯 Go ----
FROM golang:1.26 AS build

COPY server/go.mod server/go.sum /src/server/
RUN cd /src/server && go mod download

COPY server/ /src/server/

RUN cd /src/server && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/migrate-drop-photo-url ./cmd/migrate-drop-photo-url

# ---- 階段 2:執行 ----
# distroless:只含執行檔需要的最小 runtime,無 shell、體積小、攻擊面小。
# 內含 CA 憑證,連 Cloud SQL(sslmode=require 等)的 TLS 才驗得過。
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/migrate-drop-photo-url /app/migrate-drop-photo-url

ENTRYPOINT ["/app/migrate-drop-photo-url"]
